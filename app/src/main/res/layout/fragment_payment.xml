<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/layout_padding"
    tools:context=".view.checkout.payment.PaymentFragment">

    <TextView
        android:id="@+id/tv_payment_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_select_payment_option"
        android:textSize="@dimen/header3_size"
        android:textColor="@color/content_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_cash_on_delivery"
        android:layout_width="0dp"
        android:layout_height="@dimen/payment_item_height"
        android:layout_marginTop="@dimen/content_top_margin"
        android:padding="@dimen/layout_padding"
        android:background="@drawable/checkout_item_border"
        app:layout_constraintTop_toBottomOf="@id/tv_payment_head"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_cash_on_delivery"
            android:textColor="@color/content_secondary"
            android:textSize="@dimen/header4_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/img_cash_on_delivery"
            android:src="@drawable/circle_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_internet_banking"
        android:layout_width="0dp"
        android:layout_height="@dimen/payment_item_height"
        android:layout_marginTop="@dimen/content_top_margin"
        android:padding="@dimen/layout_padding"
        android:background="@drawable/checkout_item_border"
        app:layout_constraintTop_toBottomOf="@id/cl_cash_on_delivery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_internet_banking"
            android:textColor="@color/content_secondary"
            android:textSize="@dimen/header4_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/img_internet_banking"
            android:src="@drawable/circle_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/payment_item_height"
        android:layout_marginTop="@dimen/content_top_margin"
        android:padding="@dimen/layout_padding"
        android:background="@drawable/checkout_item_border"
        app:layout_constraintTop_toBottomOf="@id/cl_internet_banking"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_debit_credit_card"
            android:textColor="@color/content_secondary"
            android:textSize="@dimen/header4_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/img_card"
            android:src="@drawable/circle_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="@dimen/payment_item_height"
        android:id="@+id/cl_paypal"
        android:layout_marginTop="@dimen/content_top_margin"
        android:padding="@dimen/layout_padding"
        android:background="@drawable/checkout_item_border"
        app:layout_constraintTop_toBottomOf="@id/cl_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_paypal"
            android:textColor="@color/content_secondary"
            android:textSize="@dimen/header4_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/img_paypal"
            android:src="@drawable/circle_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btn_payment_next"
        android:text="@string/text_next"
        android:textColor="@color/white"
        android:textSize="@dimen/header3_size"
        android:padding="@dimen/button_padding"
        android:background="@drawable/button_style"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>