<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_margin"
    android:padding="@dimen/layout_padding"
    android:background="@drawable/checkout_item_border">

    <ImageView
        android:id="@+id/imgv_product_image"
        android:layout_width="90dp"
        android:layout_height="110dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_top_margin"
        android:text="@string/text_product_name"
        android:textSize="@dimen/header4_size"
        android:textColor="@color/content_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgv_product_image"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_product_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_tv_top_margin"
        android:text="@string/text_product_description"
        android:textSize="@dimen/header4_size"
        android:textColor="@color/content_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_product_name"
        app:layout_constraintStart_toStartOf="@id/tv_product_name"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_quantity"
        android:textSize="@dimen/header4_size"
        android:textColor="@color/content_tertiary"
        app:layout_constraintTop_toBottomOf="@id/tv_product_description"
        app:layout_constraintStart_toStartOf="@id/tv_product_name"/>

    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_product_price"
        android:textSize="@dimen/header4_size"
        android:textColor="@color/content_primary"
        app:layout_constraintTop_toBottomOf="@id/tv_product_description"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>