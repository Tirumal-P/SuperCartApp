<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/layout_padding"
    tools:context=".view.checkout.finalcart.FinalCartFragment">
    <include
        android:id="@+id/header"
        layout="@layout/checkout_step_header"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_total_head"
        android:text="@string/text_total_bill_amount"
        android:textSize="@dimen/header3_size"
        android:layout_marginTop="@dimen/content_top_margin"
        android:textColor="@color/content_secondary"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_total"
        android:text="@string/text_product_price"
        android:textSize="@dimen/header3_size"
        android:layout_marginTop="@dimen/content_top_margin"
        android:textColor="@color/content_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rv_cart_item_list"
        android:layout_marginTop="@dimen/content_top_margin"
        tools:listitem="@layout/final_cart_item"
        tools:itemCount="2"
        app:layout_constraintTop_toBottomOf="@id/tv_total_head"/>


    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/acbtn_chechkout"
        android:text="@string/text_checkout"
        android:background="@drawable/button_style"
        android:textColor="@color/white"
        android:textSize="@dimen/header3_size"
        android:padding="@dimen/button_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_cart_item_list"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_final_cart_message"
        android:visibility="gone"
        android:text="@string/text_cart_empty_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>