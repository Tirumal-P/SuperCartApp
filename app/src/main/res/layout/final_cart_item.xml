<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/tv_content_top_padding"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="148dp"
            android:id="@+id/imgv_product_image"
            android:src="@drawable/mobile_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/imgv_product_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_product_name"
                android:text="@string/text_product_name"
                android:textSize="@dimen/header3_size"
                android:layout_marginTop="@dimen/product_top_margin"
                android:textColor="@color/content_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_product_unit_price_text"
                android:text="@string/text_unit_price"
                android:textSize="@dimen/header3_size"
                android:textColor="@color/content_tertiary"
                android:layout_marginTop="@dimen/tv_tv_top_margin"
                android:layout_marginBottom="@dimen/tv_margin_bottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_product_name"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_unit_price"
                android:text="@string/text_product_price"
                android:textSize="@dimen/header3_size"
                android:textColor="@color/content_secondary"
                android:layout_marginBottom="@dimen/tv_margin_bottom"
                android:layout_marginStart="@dimen/tv_tv_top_margin"
                app:layout_constraintStart_toEndOf="@id/tv_product_unit_price_text"
                app:layout_constraintTop_toTopOf="@id/tv_product_unit_price_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_product_quantity_label"
                android:text="@string/text_quantity_label"
                android:textSize="@dimen/header3_size"
                android:textColor="@color/content_tertiary"
                android:layout_marginBottom="@dimen/tv_margin_bottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_product_unit_price_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_product_quantity"
                android:text="@string/text_quantity"
                android:textSize="@dimen/header3_size"
                android:textColor="@color/content_secondary"
                android:layout_marginBottom="@dimen/tv_margin_bottom"
                android:layout_marginStart="@dimen/tv_tv_top_margin"
                app:layout_constraintStart_toEndOf="@id/tv_product_unit_price_text"
                app:layout_constraintTop_toBottomOf="@id/tv_product_unit_price_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_amount_label"
                android:textSize="@dimen/header3_size"
                android:textColor="@color/content_tertiary"
                android:layout_marginBottom="@dimen/tv_margin_bottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_product_quantity_label"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_product_price"
                android:text="@string/text_product_price"
                android:textSize="@dimen/header3_size"
                android:textColor="@color/content_secondary"
                android:layout_marginBottom="@dimen/tv_margin_bottom"
                android:layout_marginStart="@dimen/tv_tv_top_margin"
                app:layout_constraintStart_toEndOf="@id/tv_product_unit_price_text"
                app:layout_constraintTop_toBottomOf="@id/tv_product_quantity"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>